<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RiderIlSpy</AssemblyName>
    <RootNamespace>RiderIlSpy</RootNamespace>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CopyLocalRuntimeTargetAssets>false</CopyLocalRuntimeTargetAssets>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RiderIlSpy.Tests" />
  </ItemGroup>

  <!--
    Strings.resx embeds with the LogicalName matching the namespace + filename
    that ResourceManager (in Strings.cs) opens by:
        new ResourceManager("RiderIlSpy.Resources.Strings", typeof(Strings).Assembly)
    Without the explicit LogicalName MSBuild derives the manifest name from the
    relative path with '.' separators, which gives the same result here, but
    pinning it makes a path rename a single-file change instead of a silent
    runtime "resource not found" failure.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>RiderIlSpy.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Rider.SDK" Version="2026.1.1" PrivateAssets="all" />
    <!--
      Pinning System.Diagnostics.TraceSource 4.3.0 resolves an NU1107 version conflict:
      Castle.Core 4.4.1 (via JetBrains.Platform.Tests.Framework) requires >= 4.3.0,
      while JetBrains.Rider.External.Iis pins it to == 4.0.0. Without this pin,
      `dotnet restore` fails. Do not remove without first updating the transitive deps.
    -->
    <PackageReference Include="System.Diagnostics.TraceSource" Version="4.3.0" />
  </ItemGroup>

  <!--
    No ICSharpCode.Decompiler reference here — ON PURPOSE. Rider's ReSharperHost
    bundles its own (old) ICSharpCode.Decompiler and the host process binds by
    simple name, so any direct reference here ends up running against whatever
    version Rider ships (historically a MissingMethodException factory). All
    decompiler work lives in RiderIlSpy.Engine, which this project deliberately
    does NOT reference at compile time: the engine + its own decompiler/SRM/SCI
    versions load in an isolated AssemblyLoadContext (IlSpyEngineLoadContext)
    and the host talks to it through the SDK-free IIlSpyEngine contract.
  -->
  <ItemGroup>
    <ProjectReference Include="..\RiderIlSpy.Contracts\RiderIlSpy.Contracts.csproj" />
  </ItemGroup>

</Project>
